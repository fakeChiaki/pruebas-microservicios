{
  "consumer": {
    "name": "admin-service"
  },
  "interactions": [
    {
      "description": "una solicitud para verificar la reserva R-1001",
      "providerStates": [
        {
          "name": "la reserva R-1001 existe y se encuentra activa"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/reservations/R-1001/verify"
      },
      "response": {
        "body": {
          "id": "R-1001",
          "valid": true
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "status": 200
      }
    },
    {
      "description": "una solicitud para verificar una reserva inexistente",
      "providerStates": [
        {
          "name": "una reserva no existe"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/reservations/R-9999/verify"
      },
      "response": {
        "body": {
          "id": "R-9999",
          "valid": false
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "12.5.2"
    },
    "pactRust": {
      "ffi": "0.4.20",
      "models": "1.2.0"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "reservation-service"
  }
}